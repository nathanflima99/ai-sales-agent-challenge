# Copie para .env e ajuste. O .env esta no .gitignore e nunca deve ser commitado.

# --- Escolha do provider ------------------------------------------------------
# openai  -> exige OPENAI_API_KEY, custa por token
# ollama  -> pode ser local (sem chave) ou remoto/cloud (com chave opcional/obrigatoria)
LLM_PROVIDER=openai

# Modelo. Deixe vazio para usar o padrao do provider
# (openai -> gpt-4o-mini, ollama -> qwen3.5:4b).
LLM_MODEL=

# --- OpenAI -------------------------------------------------------------------
# Necessaria apenas quando LLM_PROVIDER=openai. Sem ela a aplicacao sobe
# normalmente, /health responde e a UI carrega, mas perguntas retornam 503.
OPENAI_API_KEY=sk-your-key-here

# --- Ollama -------------------------------------------------------------------
# IMPORTANTE: o modelo precisa suportar tool calling. Confira com
# ollama show <modelo>: a capacidade 'tools' precisa estar listada.
# qwen3.5:4b foi validado ponta a ponta; gemma3:4b NAO suporta tools.
#
# Local:
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_API_KEY=
#
# Docker falando com Ollama no host:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Ollama Cloud / API direta autenticada:
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=<sua-chave>
#   LLM_MODEL=qwen3.5:397b
#
# Observacao: na API direta do Ollama Cloud use um nome retornado por
# https://ollama.com/api/tags. O sufixo :cloud e usado no fluxo via cliente Ollama
# local; no host direto https://ollama.com o catalogo atual expoe qwen3.5:397b.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Qwen 3.5 suporta thinking/reasoning. No Sales fica desligado por padrao para
# reduzir latencia; use true apenas para comparar qualidade/latencia conscientemente.
OLLAMA_THINKING=false

# --- Opcionais (valores abaixo sao os padroes) --------------------------------
# DATASET_PATH=dataset/sales.csv
# MAX_QUERY_ROWS=100
# MAX_AGENT_TURNS=6
# LLM_TIMEOUT_SECONDS=30
# LOG_LEVEL=INFO
