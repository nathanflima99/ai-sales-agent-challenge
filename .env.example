# Copie para .env e ajuste. O .env esta no .gitignore e nunca deve ser commitado.

# --- Escolha do provider ------------------------------------------------------
# openai  -> exige OPENAI_API_KEY, custa por token
# ollama  -> modelo local, sem chave e sem custo; exige um servidor Ollama no ar
LLM_PROVIDER=openai

# Modelo. Deixe vazio para usar o padrao do provider
# (openai -> gpt-4o-mini, ollama -> qwen3.5:4b).
LLM_MODEL=

# --- OpenAI -------------------------------------------------------------------
# Necessaria apenas quando LLM_PROVIDER=openai. Sem ela a aplicacao sobe
# normalmente, /health responde e a UI carrega, mas perguntas retornam 503.
OPENAI_API_KEY=sk-your-key-here

# --- Ollama -------------------------------------------------------------------
# IMPORTANTE: o modelo precisa suportar tool calling. Confira com
# ollama show <modelo>: a capacidade 'tools' precisa estar listada.
# qwen3.5:4b foi validado ponta a ponta; gemma3:4b NAO suporta tools.
#
# Dentro do Docker, use host.docker.internal em vez de localhost.
OLLAMA_BASE_URL=http://localhost:11434

# --- Opcionais (valores abaixo sao os padroes) --------------------------------
# DATASET_PATH=dataset/sales.csv
# MAX_QUERY_ROWS=100
# MAX_AGENT_TURNS=6
# LLM_TIMEOUT_SECONDS=30
# LOG_LEVEL=INFO
