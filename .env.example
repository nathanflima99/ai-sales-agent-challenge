# Copie para .env e preencha. O .env esta no .gitignore e nunca deve ser commitado.

# Necessaria apenas para o endpoint /ask. Sem ela a aplicacao sobe normalmente,
# /health responde e a UI carrega, mas perguntas retornam 503.
OPENAI_API_KEY=sk-your-key-here

# Opcionais (valores abaixo sao os padroes)
